{
  "mcpServers": {
    "breakaway": {
      "type": "http",
      "url": "${user_config.board_url}/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.token}",
        "X-Breakaway-Agent": "${user_config.agent_name}"
      },
      "headersHelper": "cd \"${CLAUDE_PROJECT_DIR}\" && npx --yes breakaway@1 mcp --headers"
    }
  }
}
