# Taskwarrior settings shared by everyone working on the task board (docs/tasks.md), whichever install.
# The repository's .taskrc includes this file. Never put secrets here.

news.version=3.5.0
# scripts/task and direnv set TASKRC and TASKDATA on purpose, so skip the "override" notice.
verbose=affected,blank,context,edit,header,footnote,label,new-id,news,project,special,sync,recur

# Work fields. `wid` is the stable work ID (PRD-12); the server gives one to every open task in
# a known project. `claim` says which agent or person is on it: set it with `npx breakaway claim`,
# which is atomic, never by hand.
uda.wid.type=string
uda.wid.label=ID
uda.horizon.type=string
uda.horizon.label=Horizon
uda.horizon.values=now,next,later,archive,
uda.spec.type=string
uda.spec.label=Spec
uda.claim.type=string
uda.claim.label=Claimed by
uda.pr.type=string
uda.pr.label=PR
# Cloud agents (docs/tasks.md#cloud-agents-from-the-board): start one by itself when ready, and
# the link to the session the board started.
uda.autostart.type=string
uda.autostart.label=Auto-start
uda.autostart.values=yes,
uda.session.type=string
uda.session.label=Session
# The repository a task belongs to (docs/specs/IDEA-14-multi-repo.md): a registered slug, like breakaway.
# Empty means the default repository, so tasks made before repositories never change.
# Filter with repo:<slug>; the work ID's prefix comes from the area in that repository.
uda.repo.type=string
uda.repo.label=Repo

# The GitHub security alert a task fixes (its link), for tasks the board made from one.
uda.alert.type=string
uda.alert.label=Alert

# The task structure (docs/specs/IDEA-5-task-structure.md): the current description and what done
# looks like, in Markdown. Comments are annotations; `brief_by` and `by_<epoch>` (who wrote it) are
# plain properties Taskwarrior keeps without declaring them, and so are the owner's words, quoted:
# `said_<epoch>`, `said_from_<epoch>` (where they said it), and `said_by_<epoch>` (who quoted them).
uda.brief.type=string
uda.brief.label=Description
uda.done_when.type=string
uda.done_when.label=Done when

# A decision for the owner (docs/specs/IDEA-6-decisions-with-questions.md): the questions, and the
# owner's answers once submitted, both JSON. Attach and answer them through the board, not by hand.
uda.decision.type=string
uda.decision.label=Decision
uda.decision_answers.type=string
uda.decision_answers.label=Answers

# Order work like the board: horizon first, then priority. Waiting on a decision sinks.
urgency.uda.horizon.now.coefficient=8.0
urgency.uda.horizon.next.coefficient=2.0
urgency.uda.horizon.later.coefficient=-4.0
urgency.uda.horizon.archive.coefficient=-8.0
urgency.user.tag.decide.coefficient=-3.0

# Reports: `task board`, `task agent`, `task claimed`, `task owner`.
report.board.description=Open work, best first
report.board.columns=id,wid,priority,horizon,project,tags,claim,depends.indicator,description.count
report.board.labels=ID,Work,P,Horizon,Area,Tags,Claimed by,D,Description
report.board.filter=status:pending -WAITING
report.board.sort=urgency-

report.agent.description=Ready for an agent: unblocked, unclaimed, not waiting on a decision
report.agent.columns=id,wid,priority,horizon,project,tags,description.count
report.agent.labels=ID,Work,P,Horizon,Area,Tags,Description
report.agent.filter=status:pending +READY +agent -decide claim:
report.agent.sort=urgency-

report.claimed.description=In progress, oldest claim first
report.claimed.columns=id,wid,claim,start.age,project,description.count
report.claimed.labels=ID,Work,Claimed by,For,Area,Description
report.claimed.filter=status:pending claim.any:
report.claimed.sort=start+

report.owner.description=Needs the owner: owner work and open decisions
report.owner.columns=id,wid,priority,horizon,project,tags,description.count
report.owner.labels=ID,Work,P,Horizon,Area,Tags,Description
report.owner.filter=status:pending (+owner or +decide)
report.owner.sort=urgency-

# Repositories (IDEA-14): one report and one context each, for every repository the board tracks. This file
# names none: `npx breakaway setup` writes each one's pair into the machine's own taskrc, and `repos init`
# adds a repository's into its checkout's. A task without repo belongs to the default repository, whose pair
# filters on `(repo: or repo:<slug>)` so those tasks aren't lost; every other pair filters on `repo:<slug>`.
# Switch with `task context <slug>`, back with `task context none`. A machine that never sets a context sees
# every repository.
