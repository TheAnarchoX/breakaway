# The board's secrets, for a board without a Secrets Store: each of these is set as a Worker secret, and `wrangler dev` reads them from a copy named .dev.vars (never committed).
# docs/tasks.md#a-new-install says where each value comes from.
#
# Required. Run `npx breakaway init-secrets` first: it writes tasks.env in ~/.config/breakaway, and these
# are three of its values. Keep tasks.env: it holds the sync secret, which the board never sees.
TASKS_API_TOKEN=          # BREAKAWAY_TOKEN from tasks.env: signs you in, and the CLI and agents use it
TASKS_CLIENT_ID=          # BREAKAWAY_CLIENT_ID from tasks.env: Taskwarrior's client ID
TASKS_SYNC_KEY=           # BREAKAWAY_SYNC_KEY from tasks.env: the key derived from the sync secret, not the secret

# Optional: leave each as unset. Connections shows them as not connected until a command writes them.
TASKS_GITHUB_APP_ID=unset          # the GitHub App: npx breakaway github-connect writes these three
TASKS_GITHUB_KEY=unset
TASKS_GITHUB_WEBHOOK_SECRET=unset
TASKS_ROUTINE_URL=unset            # the first repository's agent routine: npx breakaway agents-connect writes these two
TASKS_ROUTINE_TOKEN=unset
TASKS_ROUTINES=unset               # every other repository's routine: npx breakaway agents-connect --repo <slug>
TASKS_VAPID_KEY=unset              # push notifications for pings: the VAPID private key
