{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Biome formats and lints the board's code (BRK-37). `pnpm lint` checks, `pnpm format` writes.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.css"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  // Sorting imports would reorder code; leave it off so Biome only formats and lints.
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "rules": {
      "recommended": true,
      // These change markup or behavior, so they're warnings until the board's follow-up works through them in the
      // running app; then they go back to errors.
      "a11y": {
        "noAutofocus": "warn",
        "noNoninteractiveTabindex": "warn",
        "noRedundantRoles": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn"
      },
      "suspicious": {
        // The patterns that strip control characters from text (pings, attachments, routines, the site's markdown) match
        // them on purpose.
        "noControlCharactersInRegex": "off",
        // `fit` in the textarea helper is a function name, not a focused test; there are no tests in web/src.
        "noFocusedTests": "off",
        "noAssignInExpressions": "warn",
        "noShadowRestrictedNames": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "css": { "linter": { "enabled": true } },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          // [hidden], the visually-hidden helpers, and reduced motion need !important, and the stylesheets are ordered by
          // component, not by specificity.
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    }
  ]
}
