{
  // breakaway: the task board, as a new install starts from it (docs/tasks.md#a-new-install).
  // This is `node install.mjs` with comments, and test/install.test.js keeps the two the same.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "breakaway",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-26",
  // No custom domain yet: the board answers on workers.dev. Add one later by setting url in
  // breakaway.config.json and running install.mjs again.
  "workers_dev": true,
  "preview_urls": false,
  // No invocation logs (request metadata); the Worker logs nothing about tasks.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  // The version ID, which /api/ping reports so a deploy check knows the new code answers.
  "version_metadata": { "binding": "VERSION" },
  "vars": {
    // The install's names as the Worker reads them (src/install.js), from breakaway.config.json.
    // No repository: the board starts empty, and Connections walks you through registering one (CLD-131).
    "TASKS_INSTALL": {
      "name": "breakaway",
      "worker": "breakaway",
      "url": null,
      "secretsPrefix": "BREAKAWAY_",
      "secretsStore": null,
      "store": "breakaway",
      "docs": null
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v1/*", "/github/*", "/mcp", "/oauth/*", "/.well-known/oauth-*", "/login", "/logout"]
  },
  // No Secrets Store: the secrets in .dev.vars.example are set as Worker secrets.
  // Catch up with GitHub every 5 minutes, in case a webhook went missing.
  "triggers": { "crons": ["*/5 * * * *"] },
  // The board: one SQLite Durable Object, made with the Worker.
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "TaskStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskStore"] }]
}
