{
  // The update feed (BRK-8) and the landing page and docs (LCH-2). Cloudflare's Workers Builds deploys it from the site
  // branch with this file (LCH-15, site/README.md), and `wrangler dev` runs it locally.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "breakaway-releases",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  // breakaway's site answers on its own domain only. A fork that runs its own copy changes it.
  "routes": [{ "pattern": "leavethepack.dev", "custom_domain": true }],
  // The pages are static files in public/ (built from content/ by `node site/build.mjs` and committed). Only the feed
  // runs the Worker; everything else is served by the assets, with a real 404 page.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/releases.json"], "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "preview_urls": false,
  // No invocation logs (request metadata): the feed keeps nothing about who asked.
  "observability": { "enabled": false },
  "vars": { "RELEASES_REPO": "TheAnarchoX/breakaway" }
}
